    {
      "name": "aef35121",
      "displayName": "Top 10 Products by Revenue",
      "config": {
        "version": "1.1",
        "source": "SELECT\n    product_name,\n    category,\n    total_revenue,\n    total_orders\nFROM ecommerce_sales.gold.sales_by_product ORDER BY total_revenue DESC LIMIT 10\n",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)"
          }
        ]
      }
    },
    {
      "name": "f8194ab9",
      "displayName": "revenue_by_customer",
      "queryLines": [
        "-- Customer revenue values for a histogram\r\n",
        "SELECT\r\n",
        "    customer_id,\r\n",
        "    customer_name,\r\n",
        "    customer_segment,\r\n",
        "    total_revenue\r\n",
        "FROM ecommerce_sales.gold.revenue_by_customer;"
      ]
    },
    {
      "name": "3c630eee",
      "displayName": "Customer Segmentation Insights and Revenue Overview",
      "queryLines": [
        "SELECT\r\n",
        "    segment_type,\r\n",
        "    customer_count,\r\n",
        "    avg_revenue,\r\n",
        "    total_revenue\r\n",
        "FROM ecommerce_sales.gold.customer_segmentation\r\n",
        "ORDER BY CASE segment_type\r\n",
        "    WHEN 'High-Value' THEN 1\r\n",
        "    WHEN 'Repeat' THEN 2\r\n",
        "    WHEN 'One-Time' THEN 3\r\n",
        "    WHEN 'Inactive' THEN 4\r\n",
        "    ELSE 5\r\n",
        "END;"
      ]
    }
  ],
